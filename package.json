{
  "name": "model-library",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-decoders.mjs",
    "dev": "vite --host 127.0.0.1",
    "server": "node scripts/build-dashboard.mjs && tsx server/index.ts",
    "build": "node scripts/copy-decoders.mjs && node scripts/build-dashboard.mjs && vue-tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outdir=build-server",
    "start": "node build-server/index.js",
    "test": "node --import tsx --test tests/platform.test.ts tests/uuid.test.ts tests/model-validation.test.ts"
  },
  "dependencies": {
    "@zumer/snapdom": "3.8.0",
    "better-sqlite3": "^11.10.0",
    "es-module-lexer": "^3.0.5",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "multer": "^2.0.2",
    "three": "^0.180.0",
    "vue": "^3.5.22",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.23",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.0",
    "@types/three": "^0.180.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3",
    "vite": "^6.4.1",
    "vue-tsc": "^3.1.0"
  }
}
